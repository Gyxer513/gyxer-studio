{
  "name": "@gyxer-studio/mcp",
  "version": "0.5.0",
  "type": "module",
  "description": "MCP server for AI agents to manage Gyxer Studio projects",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "gyxer-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "gyxer",
    "mcp",
    "model-context-protocol",
    "nestjs",
    "codegen",
    "ai",
    "claude",
    "cursor"
  ],
  "dependencies": {
    "@gyxer-studio/schema": "0.5.0",
    "@gyxer-studio/generator": "0.5.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gyxer513/gyxer-studio.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/Gyxer513/gyxer-studio#readme",
  "bugs": {
    "url": "https://github.com/Gyxer513/gyxer-studio/issues"
